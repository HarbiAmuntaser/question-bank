generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------
// Enums
// -----------------
enum QuestionType {
  multiple_choice
  true_false
  short_answer
  essay
}

enum DifficultyLevel {
  easy
  medium
  hard
}

enum UserRole {
  admin
  editor
  moderator
}

// Content language tag per record
enum ContentLanguage {
  ar
  en
}

// Attachments
enum AttachmentKind {
  image
  pdf
  solution
  other
}

enum AttachmentStorageProvider {
  local
  external_url
  r2
}

enum AttachmentVisibility {
  public
  private
}

// SEO
// ✅ SEO
enum SeoOwnerType {
  university
  major
  subject
  chapter
  exam

  // ✅ NEW: Blog
  blog_post
  blog_topic
  blog_tag
  study_summary
}

// ✅ Attachments
enum AttachmentOwnerType {
  question
  quiz
  chapter
  subject

  blog_post
  study_summary
}

enum StudySummaryStatus {
  draft
  published
  archived
}

// Site is monolingual Arabic for SEO output, keep enum to allow future EN if needed
enum Locale {
  ar
  en
}

// -----------------
// Users (NextAuth)
// -----------------
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(admin)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  // Relations
  accounts                 Account[]
  sessions                 Session[]
  universitiesCreated      University[]        @relation("UniversityCreatedBy")
  majorsCreated            Major[]             @relation("MajorCreatedBy")
  subjectsCreated          Subject[]           @relation("SubjectCreatedBy")
  chaptersCreated          Chapter[]           @relation("ChapterCreatedBy")
  questionsCreated         Question[]          @relation("QuestionCreatedBy")
  quizzesCreated           Quiz[]              @relation("QuizCreatedBy")
  quizAttempts             QuizAttempt[]
  blogPostsCreated         BlogPost[]          @relation("BlogPostCreatedBy")
  blogPostsUpdated         BlogPost[]          @relation("BlogPostUpdatedBy")
  blogPostViewEvents       BlogPostViewEvent[] @relation("BlogPostViewUser")
  subscriptionCodesCreated SubscriptionCode[]  @relation("SubscriptionCodeCreatedBy")

  @@map("users")
}

// -----------------
// Universities
enum InstitutionType {
  university
  school
  academy
}

enum InstitutionVisibility {
  country
  global
}

model University {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  city      String?
  region    String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔒 الآن إلزامية مع قيم افتراضية
  countryCode     String                @default("SA")
  institutionType InstitutionType       @default(university)
  visibility      InstitutionVisibility @default(country)

  creator User?   @relation("UniversityCreatedBy", fields: [createdBy], references: [id])
  majors  Major[]

  @@index([countryCode, institutionType, isActive])
  @@index([institutionType, visibility, isActive])
  @@index([visibility])
  @@map("universities")
}

// -----------------
// Majors/Programs
// -----------------
model Major {
  id            String   @id @default(uuid())
  universityId  String
  name          String
  code          String?
  degreeType    String?
  durationYears Int?
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  university         University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  creator            User?               @relation("MajorCreatedBy", fields: [createdBy], references: [id])
  subjects           Subject[]
  paidAccessPlans    PaidAccessPlan[]    @relation("MajorPaidAccessPlans")
  accessEntitlements AccessEntitlement[] @relation("MajorAccessEntitlements")

  @@unique([universityId, code])
  @@map("majors")
}

// -----------------
// Subjects/Courses
// -----------------
model Subject {
  id          String   @id @default(uuid())
  majorId     String
  name        String
  code        String?
  creditHours Int?
  semester    Int?
  year        Int?
  description String?
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  major              Major               @relation(fields: [majorId], references: [id], onDelete: Cascade)
  creator            User?               @relation("SubjectCreatedBy", fields: [createdBy], references: [id])
  chapters           Chapter[]
  Quiz               Quiz[]
  studySummaries     StudySummary[]
  paidAccessPlans    PaidAccessPlan[]    @relation("SubjectPaidAccessPlans")
  accessEntitlements AccessEntitlement[] @relation("SubjectAccessEntitlements")

  @@unique([majorId, code])
  @@map("subjects")
}

// -----------------
// Chapters/Topics
// -----------------
model Chapter {
  id                 String   @id @default(uuid())
  subjectId          String
  name               String
  chapterNumber      Int?
  description        String?
  learningObjectives String[]
  isActive           Boolean  @default(true)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creator           User?               @relation("ChapterCreatedBy", fields: [createdBy], references: [id])
  questions         Question[]
  quizAttempts      QuizAttempt[]
  sessionProgress   SessionProgress[]
  platformAnalytics PlatformAnalytics[] @relation("MostPopularChapter")
  studySummaries    StudySummary[]

  @@unique([subjectId, chapterNumber])
  @@map("chapters")
}

// -----------------
// Questions
// -----------------
model Question {
  id              String          @id @default(uuid())
  chapterId       String
  questionText    String
  questionType    QuestionType    @default(multiple_choice)
  difficultyLevel DifficultyLevel @default(medium)
  points          Int             @default(1)
  explanation     String?
  imageUrl        String?
  tags            String[]
  isActive        Boolean         @default(true)
  language        ContentLanguage @default(ar)
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  chapter       Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  creator       User?            @relation("QuestionCreatedBy", fields: [createdBy], references: [id])
  options       QuestionOption[]
  userAnswers   UserAnswer[]
  quizQuestions QuizQuestion[]

  @@map("questions")
}

// -----------------
// Question options
// -----------------
model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  optionText  String
  isCorrect   Boolean  @default(false)
  optionOrder Int?
  createdAt   DateTime @default(now())

  // Relations
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@map("question_options")
}

// -----------------
// Quizzes (generated quizzes)
// -----------------
model Quiz {
  id             String         @id @default(uuid())
  title          String
  description    String?
  timeLimit      Int            @default(30)
  totalQuestions Int
  totalPoints    Int            @default(0)
  isActive       Boolean        @default(true)
  createdBy      String?
  isFreePreview  Boolean        @default(false)
  accessType     QuizAccessType @default(inherit)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  creator   User?          @relation("QuizCreatedBy", fields: [createdBy], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  subjectId String?
  subject   Subject?       @relation(fields: [subjectId], references: [id])

  @@map("quizzes")
}

// -----------------
// Quiz questions junction
// -----------------
model QuizQuestion {
  id            String @id @default(uuid())
  quizId        String
  questionId    String
  questionOrder Int
  points        Int    @default(1)

  // Relations
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([quizId, questionId])
  @@unique([quizId, questionOrder])
  @@map("quiz_questions")
}

// -----------------
// Attachment (polymorphic)
// -----------------
model Attachment {
  id                  String                    @id @default(uuid())
  ownerType           AttachmentOwnerType
  ownerId             String
  kind                AttachmentKind
  url                 String?
  title               String?
  meta                Json?
  storageProvider     AttachmentStorageProvider @default(external_url)
  visibility          AttachmentVisibility      @default(public)
  bucket              String?
  storageKey          String?
  contentType         String?
  sizeBytes           Int?
  originalName        String?
  checksumSha256      String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  blogPostAttachments BlogPostAttachment[]      @relation("BlogPostAttachmentFile")
  blogPostCovers      BlogPost[]                @relation("BlogPostCoverAttachment")
  studySummaryPdfs    StudySummary[]            @relation("StudySummaryPdf")

  @@index([ownerType, ownerId])
  @@index([storageProvider])
  @@index([visibility])
  @@index([bucket, storageKey])
  @@map("attachments")
}

// -----------------
// Study summaries
// -----------------
model StudySummary {
  id              String             @id @default(uuid())
  subjectId       String
  chapterId       String?
  title           String
  slug            String
  excerpt         String?
  content         Json?
  contentText     String?
  contentHtml     String?            @db.Text
  pdfAttachmentId String?
  status          StudySummaryStatus @default(draft)
  accessType      QuizAccessType     @default(inherit)
  publishedAt     DateTime?
  language        ContentLanguage    @default(ar)
  readingMinutes  Int?
  sortOrder       Int                @default(0)
  isFeatured      Boolean            @default(false)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter       Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  pdfAttachment Attachment? @relation("StudySummaryPdf", fields: [pdfAttachmentId], references: [id], onDelete: SetNull)

  @@unique([subjectId, slug, language])
  @@index([subjectId, status, publishedAt])
  @@index([chapterId])
  @@index([pdfAttachmentId])
  @@map("study_summaries")
}

// -----------------
// Anonymous session tracking
// -----------------
model AnonymousSession {
  id                 String              @id @default(uuid())
  sessionToken       String              @unique
  ipAddress          String?
  userAgent          String?
  country            String?
  city               String?
  createdAt          DateTime            @default(now())
  lastActivity       DateTime            @default(now())
  expiresAt          DateTime
  blogPostViewEvents BlogPostViewEvent[] @relation("BlogPostViewSession")

  // Relations
  quizAttempts       QuizAttempt[]
  sessionProgress    SessionProgress[]
  accessEntitlements AccessEntitlement[]    @relation("AnonymousSessionEntitlements")
  paymentRequests    ManualPaymentRequest[] @relation("AnonymousSessionPaymentRequests")

  @@map("anonymous_sessions")
}

// -----------------
// Quiz attempts
// -----------------
model QuizAttempt {
  id             String    @id @default(uuid())
  userId         String?
  sessionId      String?
  quizId         String?
  chapterId      String?
  totalQuestions Int
  correctAnswers Int       @default(0)
  score          Decimal?
  timeSpent      Int?
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  isCompleted    Boolean   @default(false)

  // Relations
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousSession AnonymousSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quiz             Quiz?             @relation(fields: [quizId], references: [id])
  chapter          Chapter?          @relation(fields: [chapterId], references: [id])
  userAnswers      UserAnswer[]

  @@map("quiz_attempts")
}

// -----------------
// User answers
// -----------------
model UserAnswer {
  id               String   @id @default(uuid())
  quizAttemptId    String
  questionId       String
  selectedOptionId String?
  answerText       String?
  isCorrect        Boolean?
  timeSpent        Int?
  createdAt        DateTime @default(now())

  // Relations
  quizAttempt    QuizAttempt     @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@map("user_answers")
}

// -----------------
// Session-based progress tracking
// -----------------
model SessionProgress {
  id                     String    @id @default(uuid())
  sessionId              String
  chapterId              String
  totalAttempts          Int       @default(0)
  bestScore              Decimal?
  averageScore           Decimal?
  totalQuestionsAnswered Int       @default(0)
  correctAnswers         Int       @default(0)
  lastAttemptAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  anonymousSession AnonymousSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chapter          Chapter          @relation(fields: [chapterId], references: [id])

  @@unique([sessionId, chapterId])
  @@map("session_progress")
}

// -----------------
// Analytics
// -----------------
model PlatformAnalytics {
  id                     String   @id @default(uuid())
  date                   DateTime @unique
  totalQuizAttempts      Int      @default(0)
  uniqueSessions         Int      @default(0)
  totalQuestionsAnswered Int      @default(0)
  averageSessionDuration Int?
  mostPopularChapterId   String?
  createdAt              DateTime @default(now())

  // Relations
  mostPopularChapter Chapter? @relation("MostPopularChapter", fields: [mostPopularChapterId], references: [id])

  @@map("platform_analytics")
}

// -----------------
// NextAuth tables
// -----------------
model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// -----------------
// SEO Meta (polymorphic)
// -----------------
model SeoMeta {
  id              String       @id @default(uuid())
  ownerType       SeoOwnerType
  ownerId         String
  locale          Locale       @default(ar)
  slug            String
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  canonicalUrl    String?
  noindex         Boolean      @default(false)
  nofollow        Boolean      @default(false)
  schemaJson      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([ownerType, ownerId, locale])
  @@index([ownerType, ownerId])
  @@index([slug, locale])
  @@map("seo_meta")
}

//pay
// -----------------
// Manual Subscription / Paid Access
// -----------------

enum AccessScopeType {
  major
  subject
}

enum ContactMethod {
  whatsapp
  telegram
}

enum ManualPaymentStatus {
  pending
  contacted
  paid
  rejected
  completed
}

enum QuizAccessType {
  inherit
  free
  paid
}

model PaidAccessPlan {
  id String @id @default(uuid())

  scopeType AccessScopeType
  majorId   String?
  subjectId String?

  title       String
  description String?

  price    Decimal? @db.Decimal(10, 2)
  currency String?  @default("SAR")

  isActive Boolean @default(true)

  whatsappNumber   String?
  telegramUsername String?
  contactMessage   String?

  defaultDurationDays Int?
  defaultMaxUses      Int  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  major   Major?   @relation("MajorPaidAccessPlans", fields: [majorId], references: [id], onDelete: Cascade)
  subject Subject? @relation("SubjectPaidAccessPlans", fields: [subjectId], references: [id], onDelete: Cascade)

  codes           SubscriptionCode[]
  paymentRequests ManualPaymentRequest[]

  @@index([scopeType])
  @@index([majorId])
  @@index([subjectId])
  @@index([isActive])
  @@map("paid_access_plans")
}

model SubscriptionCode {
  id String @id @default(uuid())

  codeHash    String  @unique
  codePreview String?

  planId String
  plan   PaidAccessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  durationDays Int?
  startsAt     DateTime?
  expiresAt    DateTime?

  maxUses   Int @default(1)
  usedCount Int @default(0)

  isActive Boolean @default(true)
  note     String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User? @relation("SubscriptionCodeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  entitlements AccessEntitlement[]

  @@index([planId])
  @@index([isActive])
  @@index([expiresAt])
  @@index([createdBy])
  @@map("subscription_codes")
}

model AccessEntitlement {
  id String @id @default(uuid())

  anonymousSessionId String
  anonymousSession   AnonymousSession @relation("AnonymousSessionEntitlements", fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  codeId String?
  code   SubscriptionCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)

  scopeType AccessScopeType
  majorId   String?
  subjectId String?

  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  major   Major?   @relation("MajorAccessEntitlements", fields: [majorId], references: [id], onDelete: Cascade)
  subject Subject? @relation("SubjectAccessEntitlements", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([anonymousSessionId])
  @@index([scopeType])
  @@index([majorId])
  @@index([subjectId])
  @@index([expiresAt])
  @@index([isActive])
  @@map("access_entitlements")
}

model ManualPaymentRequest {
  id String @id @default(uuid())

  anonymousSessionId String?
  anonymousSession   AnonymousSession? @relation("AnonymousSessionPaymentRequests", fields: [anonymousSessionId], references: [id], onDelete: SetNull)

  planId String?
  plan   PaidAccessPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  contactMethod ContactMethod?
  contactValue  String?

  message String?
  pageUrl String?

  status ManualPaymentStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anonymousSessionId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@map("manual_payment_requests")
}

// -----------------
// Blog
// -----------------

enum BlogPostStatus {
  draft
  published
  archived
}

enum BlogVisibility {
  global
  countries
}

enum BlogRelatedOwnerType {
  university
  major
  subject
  chapter
  quiz
}

model BlogPost {
  id          String  @id @default(uuid())
  title       String
  slug        String
  excerpt     String? // ملخص يظهر في القوائم/SEO fallback
  content     Json // محتوى المحرر (TipTap/EditorJS...الخ)
  contentText String? // نص مبسّط (اختياري) للاستخدام في previews لاحقًا
  contentHtml String? @db.Text // ✅ NEW: HTML جاهز للـ SEO/OG/Preview

  status            BlogPostStatus @default(draft)
  visibility        BlogVisibility @default(global)
  publishedAt       DateTime?
  coverAttachmentId String?
  coverAttachment   Attachment?    @relation("BlogPostCoverAttachment", fields: [coverAttachmentId], references: [id], onDelete: SetNull)

  readingMinutes Int?
  featured       Boolean @default(false)
  sortOrder      Int     @default(0)

  // اللغة الآن عربي، لكن نتركها للتوسع
  language ContentLanguage @default(ar)

  // علاقات (Primary/Secondary)
  primaryTopicId String
  primaryTopic   BlogTopic @relation("BlogPrimaryTopic", fields: [primaryTopicId], references: [id], onDelete: Restrict)

  secondaryTopics BlogPostSecondaryTopic[]
  tags            BlogPostTag[]
  attachments     BlogPostAttachment[]
  countries       BlogPostCountry[]
  relatedEntities BlogPostRelatedEntity[]

  viewEvents BlogPostViewEvent[]
  viewsCount Int                 @default(0)

  // تدقيق (من جدول User الموجود)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User? @relation("BlogPostCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User? @relation("BlogPostUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([language, slug])
  @@index([status, publishedAt])
  @@index([visibility, status])
  @@index([primaryTopicId])
  @@index([coverAttachmentId])
  @@index([featured, sortOrder])
  @@map("blog_posts")
}

model BlogTopic {
  id          String  @id @default(uuid())
  name        String // اسم الموضوع
  slug        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // علاقات
  primaryPosts   BlogPost[]               @relation("BlogPrimaryTopic")
  secondaryPosts BlogPostSecondaryTopic[]

  @@unique([name])
  @@unique([slug])
  @@index([isActive])
  @@map("blog_topics")
}

model BlogTag {
  id          String  @id @default(uuid())
  name        String // اسم الوسم
  slug        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // علاقات
  posts BlogPostTag[]

  @@unique([name])
  @@unique([slug])
  @@index([isActive])
  @@map("blog_tags")
}

model BlogPostCountry {
  postId      String
  countryCode String
  createdAt   DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, countryCode])
  @@index([countryCode])
  @@map("blog_post_countries")
}

model BlogPostRelatedEntity {
  postId    String
  ownerType BlogRelatedOwnerType
  ownerId   String
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, ownerType, ownerId])
  @@index([ownerType, ownerId])
  @@index([postId, sortOrder])
  @@map("blog_post_related_entities")
}

// ✅ Secondary topics (Post ↔ Topic) — حل الـ Primary/Secondary
model BlogPostSecondaryTopic {
  postId    String
  topicId   String
  createdAt DateTime @default(now())

  post  BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  topic BlogTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([postId, topicId])
  @@index([topicId])
  @@map("blog_post_secondary_topics")
}

// ✅ Tags (Post ↔ Tag)
model BlogPostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

// ✅ Attachments (Post ↔ Attachment)
// ملاحظة: Attachment نفسه polymorphic، لكن هذا الجدول يسمح بـ ordering/caption...الخ
model BlogPostAttachment {
  id           String  @id @default(uuid())
  postId       String
  attachmentId String
  sortOrder    Int     @default(0)
  caption      String?

  createdAt DateTime @default(now())

  post       BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  attachment Attachment @relation("BlogPostAttachmentFile", fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([postId, attachmentId])
  @@index([postId, sortOrder])
  @@map("blog_post_attachments")
}

enum BlogViewTrigger {
  dwell // بقى 8 ثوانٍ
  scroll // وصل 30% سكرول
}

model BlogPostViewEvent {
  id      String          @id @default(uuid())
  postId  String
  trigger BlogViewTrigger

  // ✅ ربط اختياري مع المستخدم/الجلسة
  userId    String?
  sessionId String?

  // معلومات إضافية (اختيارية - مفيدة للتحليل)
  dwellSeconds  Int?
  scrollPercent Int?
  referrer      String?
  path          String?

  createdAt DateTime @default(now())

  post    BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User?             @relation("BlogPostViewUser", fields: [userId], references: [id], onDelete: SetNull)
  session AnonymousSession? @relation("BlogPostViewSession", fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("blog_post_view_events")
}
