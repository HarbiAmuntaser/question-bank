# Closed until migrations, SMTP delivery and acceptance tests pass.
STUDENT_REGISTRATION_ENABLED=false
PAYMENT_V1_ENABLED=false
# New sales require both the switch above and an explicit JSON array of approved plan IDs.
PAYMENT_LAUNCH_PLAN_IDS=[]
# Existing-order contact, student submissions and Admin financial review are independent of sales.
PAYMENT_REVIEW_ENABLED=false
# Deferred for the initial direct-order launch. Issuance AND redemption remain closed.
PAYMENT_CODES_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DATABASE_URL=
DIRECT_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Optional: a SINGLE-IP header overwritten by the trusted deployment proxy.
# Unset/invalid: shared IP bucket. Never trust arbitrary X-Forwarded-For.
AUTH_TRUSTED_IP_HEADER=
# Paid files must use the private bucket; public and private bucket names must differ.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
# Short-lived bearer URL: R4 permits 60-900 seconds.
R2_SIGNED_URL_TTL_SECONDS=300
# Opt-in bootstrap only; existing users are never overwritten or promoted.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
